{
  "name": "josephlahiru-visitor-counter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create visitor-counter-db",
    "db:migrate:local": "wrangler d1 migrations apply visitor-counter-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply visitor-counter-db --remote",
    "test": "node --test"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
